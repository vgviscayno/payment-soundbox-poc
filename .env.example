# PayMongo credentials for the soundbox POC.
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# The POC runs in LIVE mode: the in-store QR exists only under the live key.
# See https://github.com/vgviscayno/payment-soundbox-poc/issues/2

# Live secret key. Basic auth, key as username with an empty password:
#   curl -u "$PAYMONGO_SECRET_KEY_LIVE:" https://api.paymongo.com/v1/webhooks
PAYMONGO_SECRET_KEY_LIVE=sk_live_

# The existing static in-store QR the demo pays against.
PAYMONGO_INSTORE_QR_ID=qr_c60b97eb975db72ee1961784
